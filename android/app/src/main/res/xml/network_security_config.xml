<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">migu.cn</domain>
        <domain includeSubdomains="true">kuwo.cn</domain>
        <domain includeSubdomains="true">qq.com</domain>
        <domain includeSubdomains="true">163.com</domain>
        <domain includeSubdomains="true">y.gtimg.cn</domain>
    </domain-config>
</network-security-config>
